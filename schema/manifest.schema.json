{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tunsuy/agthelm-templates/schema/manifest.schema.json",
  "title": "agthelm Scenario Template Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "templates.agthelm.io/v1alpha1"
    },
    "kind": {
      "const": "ScenarioTemplate"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$",
          "description": "Stable template id, e.g. discrete-mfg-aftersales"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$"
        },
        "description": {
          "type": "string"
        },
        "industry": {
          "type": "string",
          "description": "Industry slice, e.g. discrete-manufacturing"
        },
        "scenario": {
          "type": "string",
          "description": "Scenario name, e.g. aftersales-qa"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "sources",
        "acl_scope",
        "prompt",
        "tools",
        "eval_set",
        "sla",
        "compatibility"
      ],
      "properties": {
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel", "handler"],
          "properties": {
            "channel": {
              "type": "string",
              "enum": ["dingtalk.bot", "feishu.bot", "wecom.bot", "web", "api"]
            },
            "handler": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "role"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["feishu.wiki", "dingtalk.wiki", "smb", "confluence", "local"]
              },
              "role": {
                "type": "string",
                "description": "Logical role in the scenario, e.g. manuals"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "acl_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["source_sync", "pattern_remap"]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "refuse_rules"],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "refuse_rules": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["retrieve", "cite", "refuse", "hitl_write"]
          }
        },
        "eval_set": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skeleton_count", "notes"],
          "properties": {
            "skeleton_count": {
              "type": "integer",
              "minimum": 1
            },
            "notes": {
              "type": "string",
              "description": "Instances stay at customer; only skeleton ships in template"
            }
          }
        },
        "sla": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sync_hours_max", "cite_precision_min"],
          "properties": {
            "sync_hours_max": {
              "type": "number",
              "minimum": 0
            },
            "cite_precision_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "compatibility": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["system", "versions"],
            "properties": {
              "system": {
                "type": "string"
              },
              "versions": {
                "type": "string",
                "description": "Supported version range, e.g. 6.5-7.x"
              }
            }
          }
        },
        "hitl": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "write_actions": {
              "type": "string",
              "enum": ["none", "im_confirm", "webhook"]
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
